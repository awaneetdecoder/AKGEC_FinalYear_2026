# Copy to .env and fill in. .env is git-ignored.
# docker compose reads this file automatically.

# --- Database ---
DB_ROOT_PASSWORD=change-me-strong-password
# (when running without Docker) DB_URL / DB_USERNAME / DB_PASSWORD are read by the backend

# --- Auth ---
# >= 32 random characters:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
STAFF_ACCESS_CODE=choose-a-staff-code

# --- AI (Roboflow / YOLOv11) ---
ROBOFLOW_MOCK=true
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_URL=
# e.g. https://detect.roboflow.com/your-project/1

# --- Misc ---
CORS_ORIGINS=*
DEMO_MODE=false
